# ---------------- REMOTE REPOSITORY ----------------

# Create a repository on GitHub manually
# Example repository name:
# myproject

# Connect local repository with remote repository
git remote add origin https://github.com/USERNAME/myproject.git

# Check configured remote
git remote -v


# ---------------- PUSH CHANGES ----------------

# Push local commits to GitHub
git push -u origin main


# ---------------- CLONE REPOSITORY ----------------

# Clone existing remote repository into local system
git clone https://github.com/USERNAME/myproject.git

# Move inside cloned repository
cd myproject


# ---------------- FETCH UPDATES ----------------

# Fetch latest updates from remote repository
git fetch

# View fetched changes
git log --oneline --all --graph


# ---------------- PULL CHANGES ----------------

# Download and merge latest remote changes
git pull origin main


# ---------------- MAKE NEW CHANGES ----------------

# Open app.txt manually
# Add or modify content

# Check status
